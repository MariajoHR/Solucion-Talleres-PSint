Algoritmo Proceso_de_valores
	
	Definir valor1, valor2, valor3, valor4, suma, resta Como Entero
	
	Escribir "Realizaremos una suma con 4 valores"
	
	Escribir "Ingrese el valor 1"
	Leer valor1
	
	Escribir "Ingrese el valor 2"
	Leer valor2
	
	Escribir "Ingrese el valor 3"
	Leer valor3
	
	Escribir "Ingrese el valor 4"
	Leer valor4
	
	suma <- valor1 + valor2 + valor3 + valor4
	resta <- suma - valor4
	
	Escribir "El resultado de la suma es: ", suma
	Escribir "El resultado de la resta es: ", resta
	
FinAlgoritmo
