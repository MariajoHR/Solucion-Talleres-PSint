Algoritmo costo_total
	Definir precio, ganancia, impuesto, costototal Como Real
	precio = 35000000
	ganancia = (precio * 12 / 100)
	impuesto = (precio * 0 / 100)
	costototal = (precio + ganancia + impuesto)
	Escribir "precio del vehiculo es: $", precio
	Escribir "ganacia del vendedor es: $", ganancia
	Escribir "impuesto es: $", impuesto
	Escribir "costo total del vehiculo es: $", costototal
FinAlgoritmo