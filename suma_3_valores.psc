Algoritmo suma_3_valores
	Definir numero1, numero2, numero3, suma Como Entero
	
	Escribir "vamos a realizar una suma"
	Escribir "ingrese el numero1"
	Leer numero1
	
	Escribir "ingrese el numero2"
	Leer numero2
	
	Escribir "ingrese el numero3"
