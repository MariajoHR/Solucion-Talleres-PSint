Algoritmo area_trapecio
	Definir dmen, bmay, altura, area Como Real
	Escribir 'hallaremos el area de un trapecio'
	Escribir 'digita en numeros la dmen'
	Leer dmen
	Escribir 'digita en numeros el bmay'
	Leer bmay
	Escribir 'digita en numeros la altura'
	Leer altura
	area <- (dmen + bmay) / 2 * altura
	Escribir 'el area es: ', area
FinAlgoritmo